{
  "name": "logiflow-front",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend monorepo scaffold for LogiFlow (mobile + web-admin + shared libraries)",
  "workspaces": [
    "apps/*",
    "shared/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "clean": "tsc -b tsconfig.json --clean"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0"
  }
}
